// Phase L-3: Android Build Optimization Configuration
// This is an example configuration for build optimization
// Copy relevant sections to actual android/app/build.gradle

android {
    compileSdkVersion 33

    lintOptions {
        disable 'MissingDimen'
    }

    defaultConfig {
        applicationId "com.example.chess_tactics_master"
        minSdkVersion 21
        targetSdkVersion 33
        versionCode 1
        versionName "1.0.0"

        // Enable MultiDex if method count exceeds 65K
        multiDexEnabled true

        // Optimize method reference handling
        useProguard true
    }

    signingConfigs {
        release {
            // Configure with your keystore
            keyAlias 'android'
            keyPassword 'android'
            storeFile file('key.jks')
            storePassword 'android'
        }
    }

    buildTypes {
        debug {
            debuggable true
            minifyEnabled false
            shrinkResources false
        }

        release {
            debuggable false

            // Enable code optimization and obfuscation
            minifyEnabled true
            shrinkResources true
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'

            // Signing configuration
            signingConfig signingConfigs.release

            // Optimization options
            ndk {
                debugSymbolLevel 'full'
            }

            // Enable Dart obfuscation
            bundle {
                language {
                    enableSplit = true
                }
                density {
                    enableSplit = true
                }
                abi {
                    enableSplit = true
                }
            }
        }

        profile {
            debuggable false
            minifyEnabled true
            shrinkResources true
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
            signingConfig signingConfigs.release
        }
    }

    // Enable namespace to suppress manifest merger warning
    namespace "com.example.chess_tactics_master"

    // Kotlin options for better compilation
    kotlinOptions {
        jvmTarget = '1.8'
    }

    // Compilation options
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }
}

dependencies {
    implementation 'com.google.android.material:material:1.9.0'

    // Recommended: Use multidex support library for older devices
    implementation 'androidx.multidex:multidex:2.0.1'
}

// Build optimization for faster compilation
gradle.projectsEvaluated {
    tasks.withType(JavaCompile) {
        options.fork = true
        options.incremental = true
    }
}
