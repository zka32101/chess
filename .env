# Chess Tactics Master - local environment configuration
#
# This file is intentionally committed with NO real values so that
# `flutter build`/`flutter test` succeed out of the box (Flutter's asset
# bundler requires every file declared under pubspec.yaml's `assets:` to
# exist on disk, even when the app tolerates it being empty at runtime).
#
# To use a real Firebase project locally, fill in the keys below with
# your own credentials. This file is left in `.gitignore` so any values
# you add here will NOT be committed - see lib/firebase_options.dart for
# the placeholder defaults used when a key is absent.
#
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_IOS_BUNDLE_ID=
